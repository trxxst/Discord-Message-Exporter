{
  "name": "discord-backup",
  "version": "4.3.5",
  "private": true,
  "description": "Discord Backup - desktop app to export Discord servers, channels, threads and DMs into an offline local archive.",
  "main": "./out/main/index.js",
  "author": "trxxst",
  "license": "MIT",
  "homepage": "https://github.com/trxxst/Discord-Message-Exporter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trxxst/Discord-Message-Exporter.git"
  },
  "bugs": {
    "url": "https://github.com/trxxst/Discord-Message-Exporter/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
